{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email != null && auth.token.email.toLowerCase() === 'YOUR_GMAIL_HERE@gmail.com'))"
      }
    },

    "friends": {
      "$uid": { ".read": "auth != null", ".write": "auth != null" }
    },
    "friendRequests": {
      "$uid": { ".read": "auth != null", ".write": "auth != null" }
    },
    "blocks": {
      "$uid": { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" }
    },
    "notifications": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },

    "groupMembers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "groupChats": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },

    "groupCalls": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$callId": {
          ".read": "auth != null",
          ".write": "auth != null",
          "participants": {
            "$uid": { ".read": "auth != null", ".write": "auth != null" }
          },
          "signals": {
            "$from": {
              "$to": {
                "$signalId": { ".read": "auth != null", ".write": "auth != null" }
              }
            }
          }
        }
      }
    },

    "groupCallIce": {
      "$callId": {
        "$pair": {
          "$uid": {
            "$candidateId": {
              ".read": "auth != null",
              ".write": "auth != null"
            }
          }
        }
      }
    },

    "posts": {
      "$postId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "stories": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
